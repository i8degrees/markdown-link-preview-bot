# .env.dist:jeff
#
# WARNING(JEFF): Your .env file should NEVER be commited to the git 
# repository! If this does happen, you should consider the token compromised 
# and immediately reset your bot token!
#

# Docker environment (time keeping locales)
TZ=
LC_TIME=

# This token is registered by Discord when you apply for a new application.
# Paste the token given exactly as it is shown.
DISCORD_BOT_TOKEN=

# Toggle whether or not to log every response the bot responds with. This
# switch also enables print out of certain environment variables (excluding
# the bot token).
#
# This defaults to False.
DEBUG=False

# Trigger the use of experimental code branches; this should not be used
# except by developers of this bot that can fluently read the source code.
#
# This defaults to False.
EXPERIMENTAL=False

# WARNING(JEFF): This feature is presently broken.
#
# This toggle controls whether or not to effectively disable the Link
# Preview feature of the Discord client. This is a very opinionated topic,
# but for the sake of the other person that I wrote this in mind for, I
# opt to not suppress it for the time being.
#
# This defaults to False.
SUPPRESS_EMBED=False

